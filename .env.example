# =============================================================================
# CONFIGURACIÓN DE ENTORNO — PRUEBA TÉCNICA AI ENGINEER (INDRA GROUP)
# =============================================================================
# Copie este archivo a `.env` para ejecución local. No almacene secretos reales
# en el control de versiones.

# --- Entorno General ---
APP_ENV=development
LOG_LEVEL=INFO
PLANT_ID=PLANT-BOG-01
LINE_ID=LINE-PACK-02

# --- Servicio de Inferencia de Visión (Reto 2 & Reto 4) ---
VISION_SERVICE_HOST=0.0.0.0
VISION_SERVICE_PORT=8000
VISION_SERVICE_URL=http://localhost:8000
MODEL_ARTIFACT_PATH=models/coil100_classical_v1.0.0.joblib
MODEL_CARD_PATH=models/model_card.json
MODEL_VERSION=v1.0.0

# --- Umbrales del Guardrail Determinístico hacia el Robot ---
ROBOT_ANGLE_TOLERANCE_DEG=10.0
CLASS_CONFIDENCE_THRESHOLD=0.70
OOD_DISTANCE_PERCENTILE_THRESHOLD=95.0
IMAGE_MIN_LAPLACIAN_VAR=35.0

# --- Asistente Agéntico de Operación (Reto 3 & Reto 4) ---
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8001
AGENT_MAX_STEPS=5
AGENT_TOKEN_BUDGET_PER_TURN=4000
AGENT_STATE_DB_PATH=data/operational_state.sqlite

# --- Proveedor LLM (Soporte para Ollama Local, Híbrido Determinístico y Cloud) ---
# Opciones: "ollama" (usa modelos locales en Ollama como llama3.1:8b / gemma4:12b),
#           "deterministic_hybrid" (orquestador determinístico rápido + síntesis LLM opcional),
#           "openai", "azure_openai"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SEC=45

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
